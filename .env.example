# Configuration du site BF Auto : copier ce fichier en `.env` (jamais commité),
# puis remplir. Toutes les variables sont décrites en tête de src/configuration.ts,
# src/infrastructure/courriel/reglages.ts et src/infrastructure/sms/reglages.ts.
# Guide pas à pas (Gmail, SMS) : docs/exploitation/courriel-et-sms.md

# --- Site ---------------------------------------------------------------------
# production (défaut) : refuse de démarrer tant qu'une donnée obligatoire manque ;
# demonstration : affiche les propositions à valider sous un bandeau, jamais en ligne publique ;
# relecture : usage local, valeurs à valider surlignées.
MODE_SITE=demonstration
PORT=3000
HOTE=127.0.0.1
URL_PUBLIQUE=http://localhost:3000
BASE_SQLITE=var/bf-auto.sqlite
NIVEAU_JOURNAL=info
# Nombre de mandataires devant le site (1 sur Render).
TRUST_PROXY=0

# --- Courriel (Gmail par défaut) ------------------------------------------------
# Adresse Gmail du garage et son mot de passe d'application (16 lettres, créé dans
# le compte Google avec la validation en deux étapes). Jamais le mot de passe normal.
COURRIEL_FOURNISSEUR=gmail
SMTP_UTILISATEUR=bfauto94@gmail.com
SMTP_MOT_DE_PASSE=
# Destinataire des nouvelles demandes (par défaut : la boîte d'envoi elle-même).
COURRIEL_GARAGE=bfauto94@gmail.com
# Seule adresse qui reçoit les liens de connexion à l'espace garagiste.
COURRIEL_GARAGISTE=bfauto94@gmail.com
# Responsable du site : signalements de changement et alertes.
COURRIEL_RESPONSABLE_SITE=
# Lecture de la boîte (réponse « fait » du garagiste, courriels revenus en erreur).
IMAP_ACTIF=true

# --- SMS d'urgence (« Ne roulez pas ») ------------------------------------------
# Laisser vide pour désactiver. Fournisseur : ovh ou brevo (déduit des identifiants).
SMS_DESTINATAIRE=
SMS_BREVO_CLE_API=
SMS_BREVO_EXPEDITEUR=
SMS_OVH_CLE_APPLICATION=
SMS_OVH_SECRET_APPLICATION=
SMS_OVH_CLE_CONSOMMATEUR=
SMS_OVH_SERVICE=
SMS_OVH_EXPEDITEUR=
